COUNTRIES_API_URL=https://countriesnow.space/api/v0.1/countries
FRANKFURTER_API_URL=https://api.frankfurter.dev/v2
REQUEST_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO

# Postgres. Used by docker compose (the db service and the app's DATABASE_URL).
# Keep the password free of characters like @ : / ? # so it can sit inside a URL.
POSTGRES_USER=mini_api
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mini_api

# For running uvicorn on your laptop (host is localhost). Under docker compose the host is db;
# docker-compose.yml overrides this value for the app container.
DATABASE_URL=postgresql+psycopg://mini_api:change-me@localhost:5432/mini_api
